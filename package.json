{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "build:render": "cross-env NODE_OPTIONS=--max-old-space-size=400 vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "build:frontend": "vite build",
    "start": "node dist/server.cjs",
    "clean": "rm -rf dist dev.db server.js",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@ericblade/quagga2": "^1.12.1",
    "@google/genai": "^2.4.0",
    "@huggingface/transformers": "^4.2.0",
    "@phosphor-icons/react": "^2.1.10",
    "@supabase/supabase-js": "^2.108.2",
    "@types/react-signature-canvas": "^1.0.7",
    "@undecaf/zbar-wasm": "^0.11.0",
    "@zxing/browser": "^0.2.0",
    "@zxing/library": "^0.22.0",
    "axios": "^1.18.0",
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.10.0",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "googleapis": "^174.0.0",
    "html2canvas-pro": "^2.3.3",
    "jsonwebtoken": "^9.0.3",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.546.0",
    "multer": "^2.2.0",
    "onnxruntime-node": "^1.27.0",
    "pdfjs-dist": "^6.0.227",
    "ppu-paddle-ocr": "^6.0.0",
    "react": "^19.0.1",
    "react-daum-postcode": "^4.0.0",
    "react-dom": "^19.0.1",
    "react-signature-canvas": "^1.1.0-alpha.2",
    "react-zxing": "^3.0.0",
    "recharts": "^3.10.1",
    "sharp": "^0.35.3",
    "web-push": "^3.6.7",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.1.0",
    "@types/node": "^22.14.0",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.21",
    "cross-env": "^10.1.0",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "vite-plugin-compression": "^0.5.1",
    "vitest": "^4.1.10"
  }
}
